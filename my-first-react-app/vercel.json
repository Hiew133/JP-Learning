{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/uploads/:path*", "destination": "/api/uploads/:path*" }
  ],
  "functions": {
    "api/[...path].js": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "{backend/**,node_modules/kuromoji/dict/**,node_modules/sql.js/dist/**}"
    }
  }
}
