# Sao chép file này thành ".env" rồi điền API key thật của bạn.
# Lấy key MIỄN PHÍ tại: https://aistudio.google.com/apikey (không cần thẻ tín dụng)
GEMINI_API_KEY=...

# (Tùy chọn) Cổng backend lắng nghe. Mặc định 3001.
# PORT=3001

# (Tùy chọn) Origin frontend được phép gọi API (CORS). Mặc định http://localhost:5173.
# Khi deploy, đổi thành domain thật của frontend.
# CLIENT_ORIGIN=http://localhost:5173
